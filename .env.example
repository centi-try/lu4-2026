# ─── Required for Production ─────────────────────────────────────────────────
# Secret for signing JWT session cookies (min 32 chars in production)
JWT_SECRET=your-secure-random-string-at-least-32-characters

# ─── Optional overrides ──────────────────────────────────────────────────────
# Port (defaults to 3000)
PORT=3000

# Node environment (set to 'production' for production deploys)
NODE_ENV=production

# App identifier (used in session tokens)
VITE_APP_ID=lu4-2026

# Override default admin password (only used when creating admin for the first time)
# ADMIN_DEFAULT_PASSWORD=@nicolas#2021

# Data persistence paths (if using a mounted volume)
# DATA_FILE=/data/data_storage.json
# BACKUPS_DIR=/data/backups
# UPLOADS_DIR=/data/uploads

# Email — enables password reset / verification emails.
# APP_BASE_URL es a dónde apunta el link del correo (usar el dominio de la app).
# APP_BASE_URL=https://raptorsquad.fly.dev
#
# OPCIÓN A (GRATIS, recomendada): SMTP de Gmail. Envía a CUALQUIER destinatario
# sin verificar dominio. Requiere una "Contraseña de aplicación" de Google
# (Cuenta Google → Seguridad → Verificación en 2 pasos → Contraseñas de app).
# GMAIL_USER=tucorreo@gmail.com
# GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
#
# OPCIÓN A' — cualquier otro SMTP:
# SMTP_HOST=smtp.tuservidor.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=usuario
# SMTP_PASS=clave
#
# OPCIÓN B — Resend (requiere verificar un dominio propio para enviar a todos;
# en sandbox solo envía al email de la cuenta):
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=RaptorSquad <noreply@tudominio.com>

# ─── Discord bot (optional) ──────────────────────────────────────────────────
# API key que autoriza al bot de Discord a registrar ítems (POST /api/bot/items).
# Debe coincidir con la BOT_API_KEY configurada en el propio bot.
# BOT_API_KEY=una-clave-larga-y-secreta
