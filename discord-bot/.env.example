# ─── Discord ─────────────────────────────────────────────────────────────────
# Token del bot (Discord Developer Portal → tu app → Bot → Reset Token)
DISCORD_BOT_TOKEN=

# Application (Client) ID (Discord Developer Portal → tu app → General Information)
DISCORD_CLIENT_ID=

# ID del servidor de Discord donde vive el bot (activa Modo Desarrollador en
# Discord, clic derecho sobre el servidor → Copiar ID del servidor)
DISCORD_GUILD_ID=

# ─── API de RaptorSquad ──────────────────────────────────────────────────────
# URL base de la app (DEV: túnel Cloudflare; PROD: https://raptorsquad.fly.dev)
API_BASE_URL=https://raptorsquad.fly.dev

# Misma API key configurada en el servidor (variable BOT_API_KEY del server)
BOT_API_KEY=
